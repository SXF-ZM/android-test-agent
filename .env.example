# ============================================================
# 智能测试 Agent 环境配置模板
# 复制本文件为 .env 并填入真实值：copy .env.example .env
# .env 已被 .gitignore 忽略，密钥不会被提交仓库
# ============================================================

# ---- LLM Provider 一键切换：qwen（通义千问）/ deepseek（DeepSeek）----
LLM_PROVIDER=qwen

# ---- 通义千问配置（LLM_PROVIDER=qwen 时生效）----
LLM_API_KEY=sk-请替换为你的通义千问APIKey
LLM_MODEL_NAME=qwen-turbo
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- DeepSeek 配置（LLM_PROVIDER=deepseek 时生效）----
DEEPSEEK_API_KEY=sk-请替换为你的DeepSeekAPIKey
DEEPSEEK_MODEL_NAME=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- LLM 调用超时与重试（网络抖动/限流时自动重试）----
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.5

# ---- 设备模式开关 ----
# false = 安卓模拟器模式（默认）；true = USB 真机模式
IS_REAL_DEVICE=false
# 模拟器设备序列号（adb devices 查看）
EMULATOR_DEVICE_NAME=emulator-5554
# 真机 UDID（IS_REAL_DEVICE=true 时必填，adb devices 查看）
REAL_PHONE_UDID=

# ---- 被测应用 ----
APP_PACKAGE=com.android.settings
APP_ACTIVITY=.Settings

# ---- dsh-pet 鲸鱼桌宠单向状态播报（可选，默认关闭）----
# 安全说明：涉密在研设备测试必须保持 false；false 时模块完全空转，不发任何请求。
# 启用后仅向桌宠 GET /say 推送固定词表的简短状态，不传 UI 树/截图/控件文字。
PET_ENABLED=false
# dsh-pet 本地服务地址（按桌宠实际端口修改，常见 47831 / 47835）
PET_BASE_URL=http://127.0.0.1:47831

# ---- 逐步 UI 驱动 Agent（可选，默认关闭）----
# 开启后每一步读取实时 UI 树并支持按 ref/文本/坐标点击，适合多邻国等
# 无 resource-id 的动态页面；仅 Appium 后端生效。
STEPWISE_AGENT_ENABLED=false
# 单次任务最多步数与最长执行秒数
STEPWISE_MAX_STEPS=80
STEPWISE_MAX_SECONDS=900
# 每一步提供给 LLM 的最大 UI 节点数与单段文本长度
STEPWISE_UI_MAX_NODES=80
STEPWISE_UI_MAX_TEXT_LENGTH=80
# 每个动作执行后的稳定等待秒数
STEPWISE_ACTION_WAIT_SECONDS=1.0
# done 成功时要求 evidence 真实出现在当前 UI 树中（防止提前判定成功）
STEPWISE_DONE_REQUIRE_EVIDENCE=true
# 坐标点击未命中当前 UI 树节点时是否仍允许执行（默认 false，安全优先）
STEPWISE_ALLOW_UNTARGETED_TAP=false

# ---- 设备执行后端（默认 appium；mobile_mcp 为可选实验后端）----
# 网页/桌面端也可按单次任务覆盖此配置
DEVICE_BACKEND=appium
# mobile-mcp 传输方式：stdio（默认，自动启动 npx 子进程）/ http（连接已启动的 MCP 服务）
MOBILE_MCP_TRANSPORT=stdio
# stdio 启动命令（Windows 通常为 npx.cmd，Linux/macOS 为 npx）
# MOBILE_MCP_COMMAND=npx.cmd
# stdio 启动参数；默认固定为已验证的 1.0.15，便于论文复现
# 如需体验新版本可改为 @latest，但需重新验证 mobile-mcp 工具 schema
MOBILE_MCP_ARGS="-y @mobilenext/mobile-mcp@1.0.15"
# http 模式端点（mobile-mcp --listen 3000）
MOBILE_MCP_URL=http://127.0.0.1:3000/mcp
# mobile-mcp 设备标识；留空则自动使用当前模拟器/真机序列号
MOBILE_MCP_DEVICE=
# 首次启动等待秒数（npx 首次下载依赖可能较慢）
MOBILE_MCP_STARTUP_TIMEOUT=90
# 单次工具调用超时秒数
MOBILE_MCP_CALL_TIMEOUT=60
# 关闭会话等待秒数
MOBILE_MCP_CLOSE_TIMEOUT=10
# 关闭会话后是否停止宿主 mobilecli daemon（默认 true；调试时可设为 false）
MOBILE_MCP_CLEANUP_DAEMON=true

# ---- 测试产物目录（可选）----
# 每次任务自动创建 outputs/runs/<run_id>/{logs,screenshots,reports}
# RUN_OUTPUT_DIR=./outputs/runs
